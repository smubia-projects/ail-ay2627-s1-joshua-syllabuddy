# Syllabuddy API (server/, Cloud Run). Copy to .env for local dev (`npm run dev:server`).
# For deploys the whole file is uploaded as the DOTENV repo secret:
#   gh secret set DOTENV --repo smubia-projects/ail-ay2627-s1-joshua-syllabuddy < .env
# Keep values on their own lines (no inline comments after a value).

# --- OpenRouter (required) ---
# Key from https://openrouter.ai/keys
API_KEY=your-openrouter-key-here
# Main model and the backup used when the main one is busy or retired.
# The model must accept PDF/image input for scanned syllabi.
MODEL_NAME=google/gemini-2.5-flash
FALLBACK_MODEL_NAME=google/gemini-2.5-flash-lite

# --- CORS (required in production) ---
# Comma-separated frontend origins, e.g. the Vercel URL. Empty = allow any origin (local dev only).
CORS_ORIGINS=http://localhost:3000

# --- Rate limiting (shared Upstash Redis; unset = limiting disabled) ---
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
# Fallback limits per IP per window; the central control sheet overrides them at runtime.
RATE_LIMIT_EXTRACT_MAX=5
RATE_LIMIT_ADJUST_MAX=5
RATE_LIMIT_WINDOW_SECONDS=432000

# PORT is injected by Cloud Run (defaults to 8080 locally).
