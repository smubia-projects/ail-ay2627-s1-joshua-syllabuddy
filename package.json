{
  "name": "syllabuddy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "dev:server": "tsx watch --env-file-if-exists=.env server/server.ts",
    "build:server": "esbuild server/server.ts --bundle --platform=node --target=node22 --format=cjs --outfile=server/dist/server.js --log-level=warning",
    "start:server": "node server/dist/server.js",
    "test": "tsx scripts/test-planner.ts && tsx scripts/test-safety.ts && tsx scripts/test-adjust.ts && tsx scripts/test-eval.ts && tsx scripts/test-dashboard.ts && tsx scripts/test-summary.ts && tsx scripts/test-pdf.ts && tsx scripts/test-llm.ts && tsx scripts/test-repair.ts && tsx scripts/test-pipeline.ts",
    "eval": "tsx --env-file=.env scripts/eval-extraction.ts",
    "test:planner": "tsx scripts/test-planner.ts",
    "test:safety": "tsx scripts/test-safety.ts",
    "test:adjust": "tsx scripts/test-adjust.ts",
    "test:llm": "tsx scripts/test-llm.ts",
    "ping": "tsx --env-file=.env scripts/ping-openrouter.ts",
    "test:repair": "tsx scripts/test-repair.ts",
    "test:pipeline": "tsx scripts/test-pipeline.ts"
  },
  "dependencies": {
    "@upstash/redis": "^1.39.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "multer": "^2.4.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
